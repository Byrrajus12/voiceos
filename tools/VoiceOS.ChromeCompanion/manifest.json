{
  "manifest_version": 3,
  "name": "VoiceOS Chrome Companion (Alpha)",
  "version": "0.2.0",
  "description": "Thin DOM and Native Messaging bridge for bounded VoiceOS browser tasks.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reconnect VoiceOS Chrome Companion"
  }
}
