// Alpha-rescue live validation: five bounded tasks, each run once. No sign-in, purchases or forms beyond search.
[
  {
    "id": "ar.github-tauri", "name": "GitHub: search for a Rust GUI framework, open Tauri", "family": "alpha-rescue",
    "tags": ["alpha-rescue", "browser", "chrome"], "preconditions": [ { "kind": "companionConnected" } ], "timeoutSeconds": 120,
    "transcript": "Go to GitHub, search for a Rust GUI framework and open the Tauri repository.",
    "expect": { "outcome": "Complete", "final": { "activeTabUrlContains": "tauri" } }
