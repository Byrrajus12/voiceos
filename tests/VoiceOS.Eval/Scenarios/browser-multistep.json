// Short bounded multi-step browser tasks (discover -> navigate -> open). No forms submitted,
// no sign-in, no purchases. Each should need roughly 2-4 actions; the ceiling is asserted as
// an efficiency check (Partial) only where a runaway loop would clearly be wrong.
[
  {
    "id": "multi.restaurant-menu",
    "name": "Find a restaurant chain's menu page",
    "family": "browser-multistep",
    "tags": ["generalization", "browser", "chrome", "discovery"],
    "preconditions": [ { "kind": "companionConnected" } ],
    "transcript": "Find the menu for Shake Shack.",
    "timeoutSeconds": 120,
    "expect": {
      "outcome": "Complete",
      "newTabs": { "max": 1 },
      "maxActions": 6,
      // The menu opens in place on this SPA (URL stays https://shakeshack.com/#/), so the URL cannot
      // show it. The last activated control must be the menu itself: landing on the homepage from a
      // search result and declaring success leaves that result as the last activation and fails.
      "final": { "activeTabOriginContains": "shakeshack.com", "lastActivatedTargetContains": "menu" },
    },
    "cleanup": [ { "kind": "closeNewTabs" } ],
  },
  {
    "id": "multi.airline-baggage-policy",
    "name": "Find a specific policy page on an airline site",
    "family": "browser-multistep",
    "tags": ["generalization", "browser", "chrome", "discovery"],
    "preconditions": [ { "kind": "companionConnected" } ],
    "transcript": "What's Delta's checked bag policy? Pull up their page on it.",
    "timeoutSeconds": 120,
    "expect": {
      "outcome": "Complete",
      "newTabs": { "max": 1 },
      "maxActions": 6,
      "final": { "activeTabOriginContains": "delta.com", "activeTabUrlContains": "bag" },
    },
    "cleanup": [ { "kind": "closeNewTabs" } ],
  },
  {
    // Careers pages may live on a third-party job host, so only the path is asserted.
