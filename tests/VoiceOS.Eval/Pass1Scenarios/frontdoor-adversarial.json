[
  {
    "id": "frontdoor.close-tab",
    "name": "Close this tab",
    "family": "frontdoor-adversarial",
    "tags": [
      "adversarial"
    ],
    "safety": {
      "unattended": true,
      "mutatesExternalState": false
    },
    "setup": [
      {
        "kind": "startProcess",
        "file": "chrome.exe",
        "args": "https://example.org"
      },
      {
        "kind": "wait",
        "ms": 1500
      },
      {
        "kind": "startProcess",
        "file": "chrome.exe",
        "args": "https://en.wikipedia.org/wiki/Octopus"
      },
      {
        "kind": "wait",
        "ms": 3500
      }
    ],
    "preconditions": [
      {
        "kind": "companionConnected"
      },
      {
        "kind": "foregroundProcess",
        "process": "chrome"
      }
    ],
    "transcript": "Close this tab",
    "timeoutSeconds": 90,
    "expect": {
      "acceptedOutcomes": [
        "Complete",
        "Clarify",
        "Unsupported"
      ],
      "directSteps": {
        "exclude": [
          "FocusWindow",
          "CloseWindow",
          "MinimizeWindow",
          "MaximizeWindow",
          "SnapWindow",
          "MoveWindow",
          "OpenApp"
        ]
      },
      "newTabs": {
        "max": 0
      },
      "noMediaCommand": true
    },
    "cleanup": [
      {
        "kind": "closeNewTabs"
      }
    ]
  },
