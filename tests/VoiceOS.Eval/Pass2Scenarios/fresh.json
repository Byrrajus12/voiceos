      "outcome": "Complete",
      "newTabs": {
        "max": 1
      },
      "final": {
        "activeTabUrlContains": "lab/item/trail-lantern"
      }
    },
    "cleanup": [
      {
        "kind": "closeNewTabs"
      }
    ]
