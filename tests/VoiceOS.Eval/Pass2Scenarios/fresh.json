      "fresh",
      "browser",
      "chrome",
      "setup-page",
      "activate",
      "confusable"
    ],
    "setup": [
      {
        "kind": "startProcess",
        "file": "chrome.exe",
        "args": "http://localhost:18777/lab/catalog"
      },
      {
        "kind": "wait",
        "ms": 2500
      },
      {
        "kind": "focusWindow",
        "process": "chrome"
      }
    ],
    "preconditions": [
      {
        "kind": "companionConnected"
      },
      {
        "kind": "foregroundProcess",
        "process": "chrome"
      },
      {
        "kind": "activeTabOrigin",
        "contains": "localhost:18777"
      }
