  {
    "id": "real.go-tour",
    "name": "docs: named tutorial link",
    "family": "pass2-real",
    "tags": [
      "pass2",
      "real",
      "browser",
      "chrome",
      "setup-page",
      "docs",
      "activate"
    ],
    "setup": [
      {
        "kind": "startProcess",
        "file": "chrome.exe",
        "args": "https://go.dev/doc/"
      },
      {
        "kind": "wait",
        "ms": 3500
      },
      {
        "kind": "focusWindow",
        "process": "chrome"
      }
    ],
    "preconditions": [
      {
        "kind": "companionConnected"
      },
      {
        "kind": "foregroundProcess",
        "process": "chrome"
      },
      {
        "kind": "activeTabOrigin",
        "contains": "go.dev"
      }
    ],
    "transcript": "Open the tour of Go.",
    "timeoutSeconds": 90,
    "expect": {
      "outcome": "Complete",
      "newTabs": {
        "max": 1
      },
      "final": {
        "activeTabUrlContains": "tour.go.dev"
      }
    },
    "cleanup": [
      {
        "kind": "closeNewTabs"
      }
    ]
  },
