 {
  "id": "p3.open-that-again",
  "name": "Open a product, move on, open that one again",
  "family": "pass3-referents",
  "tags": [
   "pass3",
   "multi-turn",
   "reference",
   "browser",
   "fixture",
   "item"
  ],
  "preconditions": [
   {
    "kind": "companionConnected"
   },
   {
    "kind": "foregroundProcess",
    "process": "chrome"
   },
   {
    "kind": "activeTabOrigin",
    "contains": "localhost:18777"
   }
  ],
  "timeoutSeconds": 90,
  "turns": [
   {
    "transcript": "Show me the Ember Camp Stove.",
    "expect": {
     "outcome": "Complete",
     "final": {
      "activeTabUrlContains": "shop/p/ember-camp-stove"
     }
    }
   },
   {
    "transcript": "Show me the Drift Sleeping Bag.",
    "expect": {
     "outcome": "Complete",
     "final": {
      "activeTabUrlContains": "shop/p/drift-sleeping-bag"
     }
    },
    "before": [
     {
      "kind": "startProcess",
      "file": "chrome.exe",
      "args": "http://localhost:18777/shop"
     },
     {
      "kind": "wait",
      "ms": 2500
     },
     {
      "kind": "focusWindow",
      "process": "chrome"
     }
    ]
   },
   {
    "transcript": "Show me the camp stove page again.",
    "expect": {
     "outcome": "Complete",
     "final": {
      "activeTabUrlContains": "shop/p/ember-camp-stove"
